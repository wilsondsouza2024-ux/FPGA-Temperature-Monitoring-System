 if (out_valid) begin
 if (data_out !== expected_mem[i]) begin
 $display("%5d | %4d (%0d.%0dC) | %4d (%0d.%0dC) | %b | %4d |
MISMATCH",
 i, data_in, data_in/10, data_in%10,
 data_out, data_out/10, data_out%10,
 out_valid, expected_mem[i]);
 errors = errors + 1;
 end else begin
 $display("%5d | %4d (%0d.%0dC) | %4d (%0d.%0dC) | %b | %4d | OK",
 i, data_in, data_in/10, data_in%10,
 data_out, data_out/10, data_out%10,
 out_valid, expected_mem[i]);
 end
 end else begin
 $display("%5d | %4d (%0d.%0dC) | -- (filling) | %b | %4d | --",
 i, data_in, data_in/10, data_in%10,
 out_valid, expected_mem[i]);
 end
 end
 data_valid = 1'b0;
 @(negedge clk);

$display("======================================================================");
 if (errors == 0)
 $display(" TEST PASSED: All %0d samples match expected moving-average output.",
NUM_SAMPLES);
 else
 $display(" TEST FAILED: %0d mismatches found out of %0d samples.", errors,
NUM_SAMPLES);


$display("===================================================================");
 $finish;
 end
endmodule
