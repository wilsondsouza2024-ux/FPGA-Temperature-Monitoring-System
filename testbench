// "temp_data.mem" into the moving_avg_filter module,
// one sample per clock cycle, and prints/compares the
// filtered output against "expected_output.mem"
// (generated by the MATLAB / Python script).
//
// Sample format : 12-bit unsigned binary
// value = temperature(C) * 10
// e.g. 37.1 C -> 371 -> 000101110011

`timescale 1ns/1ps
module tb_moving_avg_filter;
 parameter DATA_WIDTH = 12;
 parameter NUM_SAMPLES = 100;
 parameter CLK_PERIOD = 10; // 10 ns -> 100 MHz
 // DUT signals
 reg clk;
 reg rst;
 reg data_valid;
 reg [DATA_WIDTH-1:0] data_in;
 wire out_valid;
 wire [DATA_WIDTH-1:0] data_out;
 // Memories to hold input stimulus and golden/expected output
 reg [DATA_WIDTH-1:0] input_mem [0:NUM_SAMPLES-1];
 reg [DATA_WIDTH-1:0] expected_mem [0:NUM_SAMPLES-1];
 integer i;
 integer errors;

 // Instantiate the Device Under Test

 moving_avg_filter #(
 .DATA_WIDTH(DATA_WIDTH)
 ) DUT (
 .clk (clk),
 .rst (rst),
 .data_valid (data_valid),
 .data_in (data_in),
 .out_valid (out_valid),
 .data_out (data_out)
 );

 // Clock generation

 initial clk = 1'b0;
 always #(CLK_PERIOD/2) clk = ~clk;

 // Load input stimulus and expected output from .mem files
 // (these are produced by generate_temp_signal.m or
 // generate_temp_data.py)

 initial begin
 $readmemb("temp_data.mem", input_mem);
 $readmemb("expected_output.mem", expected_mem);
 end


 // Stimulus + checking process

 initial begin
 rst = 1'b1;
 data_valid = 1'b0;
 data_in = {DATA_WIDTH{1'b0}};
 errors = 0;
 // Hold reset for a couple of clocks
 @(negedge clk);
 @(negedge clk);
 rst = 1'b0;

$display("======================================================================");
 $display(" cycle | x[n] (raw/10C) | y[n] (filtered/10C) | valid | expected | status");

$display("======================================================================");
 for (i = 0; i < NUM_SAMPLES; i = i + 1) begin
 @(negedge clk);
 data_in = input_mem[i];
 data_valid = 1'b1;
 // Wait for the registered output to update
 @(posedge clk);
 #1; // small delay so data_out has settled
